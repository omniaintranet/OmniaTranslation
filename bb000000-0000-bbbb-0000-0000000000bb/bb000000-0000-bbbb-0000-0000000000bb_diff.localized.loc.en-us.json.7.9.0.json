              "Body": "<html><body><p>You have started a login process from:</p><p>Country: <b>{{country}}</b></p><p>Device: <b>{{device}}</b></p><p>IP: <b>{{ip}}</b></p><br/><p>Please click the one-time link below to complete your login:</p><p><a href=\"{{magicLink}}\">Log in</a></p></body></html>"
            },
            "OnboardingLink": {
              "Body": "<html><body><p>Hello {{userDisplayName}}, please click the link below to set up your account:</p><p><a href=\"{{magicLink}}\">Setup account</a></p></body></html>",
